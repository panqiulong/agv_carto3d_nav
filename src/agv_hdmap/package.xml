<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_hdmap</name>
  <version>0.1.0</version>
  <description>公路的 Lanelet2 高精地图：用 Autoware 的组件加载、显示，按车道路由、沿车道行驶、遵守交通规则</description>
  <maintainer email="panqiulong@users.noreply.github.com">panqiulong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>autoware_perception_msgs</exec_depend>
  <exec_depend>lanelet2</exec_depend>
  <exec_depend>autoware_map_loader</exec_depend>
  <exec_depend>autoware_map_projection_loader</exec_depend>
  <exec_depend>autoware_lanelet2_map_visualizer</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>agv_gazebo</test_depend>       <!-- 测试用它生成的 warehouse_lanelet2_map.osm -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
