<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 8m x 6m 房间，墙高 1.5m，配合约0.57m轴距的小车，
         给 Cartographer 3D 提供墙面/障碍物特征 -->
    <model name="room_walls">
      <static>true</static>

      <link name="wall_north">
        <pose>0 3 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>8 0.1 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 0.1 1.5</size></box>
          </geometry>
          <material>
            <script><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>0 -3 0.75 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>8 0.1 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 0.1 1.5</size></box>
          </geometry>
          <material>
            <script><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>4 0 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry>
            <box><size>6 0.1 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.1 1.5</size></box>
          </geometry>
          <material>
            <script><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-4 0 0.75 0 0 1.5708</pose>
        <collision name="collision">
          <geometry>
            <box><size>6 0.1 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6 0.1 1.5</size></box>
          </geometry>
          <material>
            <script><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 房间内的几个障碍物，给建图提供更多特征 -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>1.5 1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>-1.8 -0.8 0.4 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.8</size></box></geometry>
          <material><script><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>0.5 -1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>-1.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><script><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
