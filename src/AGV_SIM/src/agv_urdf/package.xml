<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_urdf</name>
  <version>0.0.0</version>
  <description>Gazebo Classic simulation of an Ackermann AGV with a Livox Mid-360, IMU and depth camera</description>
  <maintainer email="panqiulong@todo.todo">panqiulong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>gazebo_ros</depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>ros2_livox_simulation</exec_depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
