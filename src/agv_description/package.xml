<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agv_description</name>
  <version>0.1.0</version>
  <description>Ackermann 小车模型（URDF/xacro、网格）：底盘、Livox Mid-360、IMU、深度相机及其 Gazebo 插件</description>
  <maintainer email="panqiulong@users.noreply.github.com">panqiulong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>ros2_livox_simulation</exec_depend>
  <exec_depend>agv_ackermann_drive</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
